    {
      "parameters": {
        "jsCode": "const sekarang = DateTime.now().setZone('Asia/Jakarta');\nconst formatWaktu = ['d/M/yyyy H:mm:ss', 'd/M/yyyy H:mm', 'yyyy-MM-dd H:mm:ss'];\nconst hasil = [];\n\nfor (const item of $input.all()) {\n  const data = item.json;\n  const teks = `${data['Scheduled Date']} ${data['Scheduled Time']}`.trim();\n\n  let jadwal = null;\n  for (const f of formatWaktu) {\n    const dt = DateTime.fromFormat(teks, f, { zone: 'Asia/Jakarta' });\n    if (dt.isValid) { jadwal = dt; break; }\n  }\n  if (!jadwal) continue; // format waktu tidak dikenali\n\n  if (sekarang >= jadwal) { // jadwal sudah terlewati\n    hasil.push({ json: { ...data, scheduledAt: jadwal.toISO() } });\n  }\n}\nreturn hasil;"
      },
